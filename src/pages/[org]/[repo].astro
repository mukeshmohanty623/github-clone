---
import { CodeTreeTable, type CodeTreeRow, type CodeTreeTableProps } from "@/components/CodeTreeTable";
import { Header, type HeaderProps } from "@/components/Header";
import { MainHeader, type MainHeaderProps } from "@/components/MainHeader";
import { DropdownMenuComponent } from "@/components/PoppoverComponent";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";

export const prerender = false;

const { org, repo } = Astro.params;
let response = await fetch(`https://api.github.com/repos/${org}/${repo}`, {
  headers: {
    Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,
  },
});
let headerProps!: HeaderProps;
let mainHeaderProps!: MainHeaderProps;
let codeTreeProps!:CodeTreeTableProps;
let codeTreeRows:CodeTreeRow[] = []
let bufferContent: any;
if (response?.status == 200) {
  const data = await response.json();

  let userData = await (
    await fetch(data?.owner?.url, {
      headers: {
        Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,
      },
    })
  ).json();

  headerProps = {
    orgName: (data?.full_name as string)?.split("/")[0],
    repoName: data?.name,
    orgUrl: userData?.html_url,
    repoUrl: data?.html_url,
    orgType: userData?.type,
    ownerDetails: {
      displayName: userData?.name,
      avatarUrl: userData?.avatar_url,
      location: userData?.location,
      about: userData?.bio,
      ownerUrl: userData?.html_url,
      repoCount: userData?.public_repos,
    },
  };
  let readmeData = await (
    await fetch(`https://api.github.com/repos/${org}/${repo}/readme`, {
      headers: {
        Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,
      },
    })
  ).json();
  bufferContent = Buffer.from(readmeData?.content, "base64").toString("utf8");
  mainHeaderProps = {
    branchUrl: `${data?.html_url}/branches`,
    tagsUrl: `${data?.html_url}/tags`,
    uploadFileUrl: `${data?.html_url}/upload/main`,
    newFileUrl: `${data?.html_url}/new/main`,
    tagsCount: "20",
    branchCount: "20",
  };
  codeTreeRows = [
    {
      type:'folder',
      commitMessage: 'test: migrated register.test.js from tap to node:test',
      commitMessageUrl:'https://github.com/fastify/fastify/commit/84d7e6f0012149f111bcbc3eadc34222034a7a08',
      fileName:'.github',
      prId:'5918',
      lastModified: new Date().toISOString(),
    }
  ]
  for(let i=1;i<=30;i++){
    if(i%2==0){
      codeTreeRows.push({
        type:'folder',
      commitMessage: 'test: migrated register.test.js from tap to node:test',
      commitMessageUrl:'https://github.com/fastify/fastify/commit/84d7e6f0012149f111bcbc3eadc34222034a7a08',
      fileName:'.github',
      prId:'5918',
      lastModified: new Date().toISOString(),
      })
    }else{
      codeTreeRows.push({
      type:'file',
      commitMessage: 'test: migrated register.test.js from tap to node:test',
      commitMessageUrl:'https://github.com/fastify/fastify/commit/84d7e6f0012149f111bcbc3eadc34222034a7a08',
      fileName:'.github',
      prId:'5918',
      lastModified: new Date().toISOString(),
      })
    }
  }
  codeTreeProps = {
    branchName: 'main',
    repoUrl: data?.html_url,
    lastCommitMessage: 'test: migrated register.test.js from tap to node:test (#5918)',
    lastCommitMessageUrl: 'https://github.com/fastify/fastify/commit/84d7e6f0012149f111bcbc3eadc34222034a7a08',
    lastCommitid: '84d7e6f',
    lastCommitModifiedTime: new Date().toISOString(),
    totalCommits:'4,284',
    lastCommitAuthorName:'Tony133',
    lastCommitAuthorImageSrcUrl:'https://github.com/shadcn.png',
    lastCommitPrId:'5918',
    rows:codeTreeRows
  }
}
---

{
  response?.status == 200 ? (
    <Layout>
      <Header client:load slot="header" {...headerProps} />
      <div class="grid lg:grid-cols-[2fr_1fr] grid-cols-[1fr] max-w-[1280px] px-4 mr-auto ml-auto py-2">
        <div class="">
          <MainHeader {...mainHeaderProps} client:load />
          <CodeTreeTable {...codeTreeProps} client:load/>
        </div>
        <div class="border-black border-solid border h-96" />
      </div>
    </Layout>
  ) : (
    <Layout>
      <div class="w-full">
        <h1 class="text-center">404 not found</h1>
      </div>
    </Layout>
  )
}
